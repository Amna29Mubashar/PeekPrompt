    "AI rewriting needs macOS 26 with Apple Intelligence. Using basic cleanup instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب إعادة الصياغة بالذكاء الاصطناعي macOS 26 مع Apple Intelligence. سيتم استخدام تنظيف أساسي بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Umschreiben erfordert macOS 26 mit Apple Intelligence. Stattdessen wird eine einfache Bereinigung verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reescritura con IA requiere macOS 26 con Apple Intelligence. Se usará una limpieza básica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réécriture par IA nécessite macOS 26 avec Apple Intelligence. Nettoyage de base utilisé à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riscrittura con IA richiede macOS 26 con Apple Intelligence. Verrà usata una pulizia di base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIによる書き直しにはApple Intelligence搭載のmacOS 26が必要です。代わりに基本的な整形を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 다시 쓰기에는 Apple Intelligence가 있는 macOS 26이 필요합니다. 대신 기본 정리를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reescrita com IA requer macOS 26 com Apple Intelligence. Usando uma limpeza básica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 改写需要搭载 Apple Intelligence 的 macOS 26。将改用基本整理。"
          }
        }
      }
    },
    "Add a [pause] cue between paragraphs": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إشارة [pause] بين الفقرات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen Absätzen einen [pause]-Hinweis einfügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una indicación [pause] entre párrafos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un repère [pause] entre les paragraphes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un segnale [pause] tra i paragrafi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "段落の間に[pause]の合図を入れる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문단 사이에 [pause] 신호 추가"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar uma marcação [pause] entre parágrafos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在段落之间添加 [pause] 提示"
          }
