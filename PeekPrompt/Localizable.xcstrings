    "Rewrite this script so it's easier to say out loud": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescribir este guion para que sea más fácil de decir en voz alta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrire ce script pour qu’il soit plus facile à dire à voix haute"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Skript so umschreiben, dass es sich leichter vorlesen lässt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscrivi questo copione per renderlo più facile da dire ad alta voce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescrever este roteiro para ficar mais fácil de falar em voz alta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声に出して読みやすいように原稿を書き直す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 내어 읽기 쉽게 원고 다시 쓰기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改写此稿子,让它更容易朗读"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة صياغة هذا النص ليسهل قوله بصوت عالٍ"
          }
        }
      }
    },
    "Rewrites “%@” so it's easier to say out loud. You'll see the result here before anything changes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescribe «%@» para que sea más fácil de decir en voz alta. Verás el resultado aquí antes de que cambie nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrit « %@ » pour qu’il soit plus facile à dire à voix haute. Vous verrez le résultat ici avant toute modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt „%@“ so um, dass es sich leichter vorlesen lässt. Du siehst das Ergebnis hier, bevor sich etwas ändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscrive “%@” per renderlo più facile da dire ad alta voce. Vedrai il risultato qui prima che cambi qualcosa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescreve “%@” para ficar mais fácil de falar em voz alta. Você verá o resultado aqui antes de qualquer mudança."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を声に出して読みやすく書き直します。変更する前に、ここで結果を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 소리 내어 읽기 쉽게 다시 씁니다. 변경하기 전에 여기에서 결과를 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改写“%@”,让它更容易朗读。在做任何更改之前,你会先在这里看到结果。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد صياغة ”%@“ ليسهل قوله بصوت عالٍ. سترى النتيجة هنا قبل أن يتغير أي شيء."
          }
        }
      }
    },
