    "Drag the prompter to move it. Keep it close to your camera for the best eye contact.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el teleprompter para moverlo. Mantenlo cerca de la cámara para un mejor contacto visual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser le prompteur pour le déplacer. Gardez-le près de la caméra pour un meilleur contact visuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
