    "Moves to the next slide or chunk in Presentation or Memorize mode.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa a la siguiente diapositiva o fragmento en el modo presentación o memorizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe à la diapositive ou partie suivante en mode présentation ou mémorisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt zur nächsten Folie bzw. zum nächsten Abschnitt im Präsentations- oder Auswendiglern-Modus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa alla slide o al blocco successivo nella modalità presentazione o memorizza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avança para o próximo slide ou trecho no modo apresentação ou memorizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンテーションモードまたは暗記モードで次のスライドやチャンクに進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레젠테이션 또는 암기 모드에서 다음 슬라이드나 구간으로 이동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在演示或背诵模式下前进到下一张幻灯片或下一个片段。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتقل إلى الشريحة أو المقطع التالي في وضع العرض أو الحفظ."
          }
        }
      }
    },
