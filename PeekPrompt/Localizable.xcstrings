    "Learn your script with words gradually hidden.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ نصك مع إخفاء الكلمات تدريجيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne dein Skript, während Wörter nach und nach verschwinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende tu guion ocultando palabras poco a poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez votre script en masquant les mots progressivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara il copione nascondendo le parole a poco a poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語を少しずつ隠しながら原稿を覚えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 점점 숨기며 원고를 외웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenda seu roteiro com palavras ocultadas aos poucos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐步隐藏词语,帮你背熟稿子。"
          }
        }
      }
    },
