          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic y pulsa el nuevo atajo. Suprimir lo desactiva; Esc cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
