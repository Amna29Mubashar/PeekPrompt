          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il prompter per spostarlo. Tienilo vicino alla fotocamera per un migliore contatto visivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o teleprompter para movê-lo. Mantenha-o perto da câmera para um melhor contato visual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプターをドラッグして移動します。視線を合わせやすいよう、カメラの近くに置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프터를 드래그해 이동하세요. 시선을 맞추려면 카메라 가까이에 두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动提词器即可移动。放在摄像头附近,眼神交流效果最好。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
