    "The link contains a secret code and changes each time you turn the remote on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الرابط على رمز سري يتغيّر في كل مرة تشغّل فيها جهاز التحكم عن بُعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link enthält einen geheimen Code und ändert sich bei jedem Einschalten der Fernbedienung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace contiene un código secreto y cambia cada vez que activas el control remoto."
