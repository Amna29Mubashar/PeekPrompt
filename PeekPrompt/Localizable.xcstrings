        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프터를 드래그해 이동하세요. 시선을 맞추려면 카메라 가까이에 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o teleprompter para movê-lo. Mantenha-o perto da câmera para um melhor contato visual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动提词器即可移动。放在摄像头附近,眼神交流效果最好。"
