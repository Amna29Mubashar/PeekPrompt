    "Drag the prompter to move it. Keep it close to your camera for the best eye contact.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الملقّن لنقله. أبقِه قريبًا من الكاميرا للحفاظ على التواصل البصري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
