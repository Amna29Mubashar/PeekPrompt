          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크에는 비밀 코드가 포함되며 리모컨을 켤 때마다 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
