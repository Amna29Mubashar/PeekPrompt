    "Click a shortcut, then press the new keys. Delete turns it off, Esc cancels.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un atajo y pulsa las nuevas teclas. Suprimir lo desactiva; Esc cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un raccourci, puis appuyez sur les nouvelles touches. Supprimer le désactive, Échap annule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf einen Kurzbefehl und drücke die neuen Tasten. Löschen schaltet ihn aus, Esc bricht ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un’abbreviazione, poi premi i nuovi tasti. Elimina la disattiva, Esc annulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um atalho e pressione as novas teclas. Apagar o desativa, Esc cancela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットをクリックして新しいキーを押します。Deleteでオフ、Escでキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 클릭한 다음 새 키를 누르세요. Delete는 끄기, Esc는 취소입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按快捷键后按下新的按键。按 Delete 关闭,按 Esc 取消。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على اختصار ثم اضغط المفاتيح الجديدة. Delete لإيقافه وEsc للإلغاء."
          }
