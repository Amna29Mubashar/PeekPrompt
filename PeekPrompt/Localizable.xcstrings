    "Speech recognition is turned off for PeekPrompt in System Settings → Privacy & Security.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para PeekPrompt en Configuración del Sistema → Privacidad y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour PeekPrompt dans Réglages Système → Confidentialité et sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung ist für PeekPrompt in Systemeinstellungen → Datenschutz & Sicherheit deaktiviert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è disattivato per PeekPrompt in Impostazioni di Sistema → Privacy e sicurezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o PeekPrompt em Ajustes do Sistema → Privacidade e Segurança."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PeekPromptの音声認識がシステム設定 → プライバシーとセキュリティでオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안에서 PeekPrompt의 음성 인식이 꺼져 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
