    "Sits right under the camera, so you look straight at your audience.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقع أسفل الكاميرا مباشرةً لتنظر إلى جمهورك مباشرةً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzt direkt unter der Kamera, damit du dein Publikum direkt ansiehst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sitúa justo debajo de la cámara para que mires directamente a tu público."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se place juste sous la caméra pour que vous regardiez votre public dans les yeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si trova proprio sotto la fotocamera, così guardi dritto il tuo pubblico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラのすぐ下に表示されるので、視聴者をまっすぐ見つめられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 바로 아래에 있어 시청자를 똑바로 바라볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica logo abaixo da câmera, para você olhar direto para o público."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于摄像头正下方,让你直视观众。"
          }
        }
      }
    },
