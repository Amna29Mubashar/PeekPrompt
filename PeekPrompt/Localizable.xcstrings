    "Apple Intelligence is still getting ready (downloading). Using basic cleanup for now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún se está preparando (descargando). Por ahora se usará una limpieza básica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est encore en préparation (téléchargement). Nettoyage de base utilisé pour l’instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wird noch vorbereitet (Download läuft). Vorerst wird eine einfache Bereinigung verwendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è ancora in preparazione (download in corso). Per ora verrà usata una pulizia di base."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence ainda está sendo preparado (baixando). Usando uma limpeza básica por enquanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceはまだ準備中です(ダウンロード中)。当面は基本的な整形を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 아직 준비 중입니다(다운로드 중). 지금은 기본 정리를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 仍在准备中(正在下载)。暂时使用基本整理。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال Apple Intelligence قيد التجهيز (جارٍ التنزيل). سيتم استخدام تنظيف أساسي حاليًا."
          }
        }
      }
    },
    "Apple Intelligence isn't available right now. Using basic cleanup instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no está disponible ahora. Se usará una limpieza básica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
