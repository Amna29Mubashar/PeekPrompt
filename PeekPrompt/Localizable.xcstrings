    "Scrolls at a steady speed you choose.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمرّر بسرعة ثابتة تختارها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollt mit einem gleichmäßigen Tempo deiner Wahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desplaza a la velocidad constante que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défile à la vitesse constante de votre choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorre a una velocità costante a tua scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ一定の速度でスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 일정한 속도로 스크롤합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rola em uma velocidade constante que você escolhe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以你选择的固定速度滚动。"
          }
        }
      }
    },
    "Scrolls while you speak. Pauses when you go quiet or mute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمرّر أثناء حديثك ويتوقف عندما تصمت أو تكتم الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollt, während du sprichst. Pausiert, wenn du still bist oder stummschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desplaza mientras hablas. Se pausa cuando callas o silencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défile pendant que vous parlez. S’arrête quand vous vous taisez ou coupez le micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorre mentre parli. Si ferma quando taci o silenzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話している間スクロールし、黙るかミュートすると止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 동안 스크롤하고, 조용해지거나 음소거하면 멈춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rola enquanto você fala. Pausa quando você fica em silêncio ou silencia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话时滚动,安静或静音时暂停。"
          }
        }
      }
    },
    "See if you're ahead of or behind your target.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف إن كنت متقدمًا أو متأخرًا عن هدفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, ob du vor oder hinter deinem Ziel liegst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si vas adelantado o atrasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez si vous êtes en avance ou en retard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri se sei in anticipo o in ritardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標より早いか遅いかを確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표보다 빠른지 늦은지 확인하세요."
          }
        },
