        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعود إلى بداية النص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springt zum Anfang des Skripts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve al principio del guion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revient au début du script."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna all’inizio del copione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原稿の先頭に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고 맨 처음으로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta ao início do roteiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳回稿子开头。"
          }
        }
      }
    },
